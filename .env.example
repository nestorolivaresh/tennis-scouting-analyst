# Copy to .env and fill in. .env is gitignored; never commit real values.

# Local Postgres. docker compose reads these from .env.
POSTGRES_USER=tennis
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=tennis
POSTGRES_PORT=5433

# Used by the Python code (ingestion now, API later). Must match the values above.
DATABASE_URL=postgresql://tennis:change-me-local-only@127.0.0.1:5433/tennis

# Milestone 3 onward (D-017, D-020, D-022). Keep the master copy of the key in 1Password; set
# a monthly spend limit in the Anthropic Console before using it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: thinking effort (low, medium, high, xhigh, max) and the token budget per request.
ANTHROPIC_EFFORT=low
AGENT_TOKEN_BUDGET=120000
