# Copy to .env and fill in. .env is gitignored; never commit real values.

# Local Postgres. docker compose reads these from .env.
POSTGRES_USER=tennis
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=tennis
POSTGRES_PORT=5433

# Used by the Python code (ingestion now, API later). Must match the values above.
DATABASE_URL=postgresql://tennis:change-me-local-only@127.0.0.1:5433/tennis

# Milestone 3 onward. Check the Anthropic docs for current model names.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
